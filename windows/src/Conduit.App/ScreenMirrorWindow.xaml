<Window x:Class="Conduit.App.ScreenMirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone screen — Conduit" Height="760" Width="420"
        Background="#000000" WindowStartupLocation="CenterScreen">
    <Grid>
        <Image x:Name="Screen" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="WaitingText" Text="Waiting for the phone…"
                   Foreground="#AAFFFFFF" FontSize="15"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
