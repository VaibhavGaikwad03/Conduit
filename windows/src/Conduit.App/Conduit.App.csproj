<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\conduit.ico</ApplicationIcon>
    <AssemblyName>Conduit</AssemblyName>
    <RootNamespace>Conduit.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conduit.Core\Conduit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\conduit.ico" />
  </ItemGroup>

  <!-- Bundle the native virtual-camera DLL next to the app when it has been built.
       WebcamService installs it from here to a service-readable location. -->
  <ItemGroup>
    <None Include="..\..\native\ConduitCamera\build\Release\ConduitCamera.dll"
          Condition="Exists('..\..\native\ConduitCamera\build\Release\ConduitCamera.dll')"
          Link="ConduitCamera.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
