<Window x:Class="Conduit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conduit" Height="640" Width="960" MinWidth="720" MinHeight="560"
        Icon="pack://application:,,,/Assets/conduit.ico"
        Background="{StaticResource WindowGrad}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <!-- Root: main content + the flyout drawer overlaid on top -->
    <Grid>

        <!-- ============ Main content ============ -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="☰" Click="OnToggleDrawer" Style="{StaticResource GhostButton}"
                            Width="46" Height="42" FontSize="18" Margin="0,0,12,0" ToolTip="Devices"/>
                    <Image Source="pack://application:,,,/Assets/conduit.ico" Width="34" Height="34"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Conduit" Style="{StaticResource H1}"/>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
                            <Run Text="This PC ·"/><Run Text="{Binding SelfName}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Connection pill -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1" CornerRadius="20" Padding="14,7">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusPillBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionSummary}" Margin="8,0,0,0"
                                   Foreground="{StaticResource Fg}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Body: selected-device detail -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <!-- Placeholder when no device is selected -->
                    <Border Style="{StaticResource CardBorder}"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Margin="0,10">
                            <TextBlock Text="Select a device" Foreground="{StaticResource Fg}"
                                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tap ☰ at the top-left to open the device list, then choose a device to see its options."
                                       Foreground="{StaticResource Muted}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Selected-device detail header -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                                     Fill="{Binding Selected.StatusBrush}"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Selected.Name}" Foreground="{StaticResource Fg}"
                                           FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Selected.Status}" Foreground="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" DataContext="{Binding Selected}">
                                <Button Style="{StaticResource PrimaryButton}" Height="32"
                                        Content="{Binding ActionText}" Click="OnDeviceAction"
                                        Visibility="{Binding Connected, Converter={StaticResource InverseBoolToVis}}"/>
                                <Button Style="{StaticResource GhostButton}" Height="32"
                                        Content="Disconnect" Click="OnDisconnect"
                                        Visibility="{Binding Connected, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource GhostButton}" Height="32" Margin="8,0,0,0"
                                        Content="Forget" Click="OnForget"
                                        Visibility="{Binding Paired, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- File transfers (only while active) -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding HasTransfers, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="FILE TRANSFERS" Style="{StaticResource Section}"/>
                            <ItemsControl ItemsSource="{Binding Transfers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Fg}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="360"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Status}" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Muted}" FontSize="12"/>
                                            </Grid>
                                            <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                         Value="{Binding Percent}" Foreground="{Binding BarBrush}"
                                                         Background="{StaticResource Stroke}" BorderThickness="0"
                                                         Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Offline hint: selected but not connected -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding SelectedOffline, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="This device is offline. Connect it to send files, clipboard and control media."
                                   Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Connected but not paired: waiting on confirmation before features unlock -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding SelectedConnectedUnpaired, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="NOT PAIRED YET" Style="{StaticResource Section}"/>
                            <TextBlock Text="Connected, but not paired. Confirm the 6-digit code on both devices to unlock features — accept the pairing request on your phone (or click Pair, then approve here)."
                                       Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Phone status -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding SelectedReady, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="PHONE STATUS" Style="{StaticResource Section}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Battery" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <ProgressBar Width="90" Height="6" Minimum="0" Maximum="100"
                                                 Value="{Binding BatteryLevel}" Foreground="{StaticResource Cyan}"
                                                 Background="{StaticResource Stroke}" BorderThickness="0"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BatteryText}" Foreground="{StaticResource Fg}"
                                               FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,12" Opacity="0.5"/>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Ringer" Foreground="{StaticResource Muted}" FontSize="13"/>
                                <TextBlock Text="{Binding RingerText}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource Fg}" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Now playing" Foreground="{StaticResource Muted}" FontSize="13"/>
                                <TextBlock Text="{Binding NowPlaying}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource Fg}" FontWeight="SemiBold" FontSize="13"
                                           MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Quick actions -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding SelectedReady, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="QUICK ACTIONS" Style="{StaticResource Section}"/>
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,6,10" Content="📋  Send clipboard" Click="OnSendClipboard"/>
                                <Button Style="{StaticResource GhostButton}" Margin="6,0,0,10" Content="📁  Send file…" Click="OnSendFile"/>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Content="🔒  Lock phone" Click="OnLockPhone"/>
                                <Button x:Name="RingButton" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Content="🔔  Ring phone" Click="OnRingPhone"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Open a link on the phone -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding SelectedReady, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="OPEN LINK ON PHONE" Style="{StaticResource Section}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LinkBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                                         Padding="10,0" KeyDown="OnLinkKeyDown" CaretBrush="{StaticResource Fg}"
                                         Background="#0AFFFFFF" Foreground="{StaticResource Fg}"
                                         BorderBrush="{StaticResource Stroke}" BorderThickness="1"/>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="34"
                                        Margin="8,0,0,0" Content="🌐  Open" Click="OnOpenLink"/>
                            </Grid>
                            <TextBlock Text="Opens the URL in your phone's browser."
                                       Foreground="{StaticResource Muted}" FontSize="12" Margin="2,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Search files on the phone -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding SelectedReady, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="SEARCH PHONE FILES" Style="{StaticResource Section}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                                         Padding="10,0" KeyDown="OnSearchKeyDown" CaretBrush="{StaticResource Fg}"
                                         Background="#0AFFFFFF" Foreground="{StaticResource Fg}"
                                         BorderBrush="{StaticResource Stroke}" BorderThickness="1"/>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="34"
                                        Margin="8,0,0,0" Content="🔍  Search" Click="OnSearchFiles"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SearchStatus}" Foreground="{StaticResource Muted}"
                                           FontSize="12" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="28"
                                        Content="✕  Close" Click="OnClearSearch"
                                        Visibility="{Binding SearchActive, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0AFFFFFF" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Fg}"
                                                               FontWeight="SemiBold" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                               HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="30"
                                                        Content="⬇  Download" Click="OnDownloadResult"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Browse the phone's folders -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding SelectedReady, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="BROWSE PHONE FILES" Style="{StaticResource Section}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding BrowsePath}" Foreground="{StaticResource Fg}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding BrowseActive, Converter={StaticResource BoolToVis}}"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="30"
                                        Margin="8,0,0,0" Content="⬆  Up" Click="OnBrowseUp"
                                        Visibility="{Binding CanGoUp, Converter={StaticResource BoolToVis}}"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="30"
                                        Margin="8,0,0,0" Content="✕  Close" Click="OnCloseBrowse"
                                        Visibility="{Binding BrowseActive, Converter={StaticResource BoolToVis}}"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Height="30"
                                        Margin="8,0,0,0" Content="📂  Browse" Click="OnBrowseFiles"/>
                            </Grid>
                            <TextBlock Text="{Binding BrowseStatus}" Foreground="{StaticResource Muted}"
                                       FontSize="12" Margin="2,8,0,0"
                                       Visibility="{Binding BrowseActive, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding BrowseEntries}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0AFFFFFF" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Fg}"
                                                               FontWeight="SemiBold" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="380"
                                                               HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="30"
                                                        Content="Open  ▸" Click="OnBrowseEntry"
                                                        Visibility="{Binding IsDir, Converter={StaticResource BoolToVis}}"/>
                                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="30"
                                                        Content="⬇  Download" Click="OnBrowseEntry"
                                                        Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Media remote -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding SelectedReady, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="MEDIA REMOTE" Style="{StaticResource Section}"/>
                            <UniformGrid Columns="3">
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Content="⏮  Prev" Click="OnMediaPrev"/>
                                <Button Style="{StaticResource PrimaryButton}" Margin="6,0,6,0" Content="⏯  Play / Pause" Click="OnMediaPlayPause"/>
                                <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0" Content="⏭  Next" Click="OnMediaNext"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Webcam -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding SelectedReady, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="WEBCAM" Style="{StaticResource Section}"/>
                            <TextBlock Text="Use the phone's camera as a webcam ('Conduit Camera') in any app."
                                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button x:Name="WebcamButton" Style="{StaticResource PrimaryButton}"
                                    Content="🎥  Use phone as webcam" Click="OnToggleWebcam"/>
                            <Button x:Name="SwitchCameraButton" Style="{StaticResource GhostButton}"
                                    Content="🔄  Switch to back camera" Click="OnSwitchCamera"
                                    Margin="0,8,0,0" IsEnabled="False" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Screen mirror -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding SelectedReady, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="SCREEN MIRROR" Style="{StaticResource Section}"/>
                            <TextBlock Text="Show the phone's screen in a window on this PC. You'll approve capture on the phone."
                                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button x:Name="ScreenButton" Style="{StaticResource PrimaryButton}"
                                    Content="🖥  Mirror phone screen" Click="OnToggleScreen"/>
                        </StackPanel>
                    </Border>

                    <!-- Recent notifications -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="RECENT FROM PHONE" Style="{StaticResource Section}" VerticalAlignment="Center"/>
                                <Button Content="Clear" Click="OnClearNotifications" Style="{StaticResource GhostButton}"
                                        Height="28" Padding="12,0" FontSize="12" HorizontalAlignment="Right"
                                        ToolTip="Clear this list on the PC (your phone's notifications stay)"
                                        Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <TextBlock Text="No notifications yet. Enable Notification access for Conduit on your phone."
                                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding HasNotifications, Converter={StaticResource InverseBoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding Notifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0AFFFFFF" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Fg}" FontSize="13">
                                                        <Run Text="{Binding AppName}"/><Run Text="  ·  "/><Run Text="{Binding Title}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource Muted}"
                                                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Muted}"
                                                               FontSize="10" Opacity="0.7" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Click="OnDismissNotification"
                                                        Style="{StaticResource IconButton}"
                                                        Width="28" Height="28" VerticalAlignment="Top" Margin="8,0,0,0"
                                                        ToolTip="Remove this one from the PC list">
                                                    <Path Data="M0,0 L1,1 M1,0 L0,1" Stretch="Uniform"
                                                          Width="11" Height="11" Stroke="#FF6B6B" StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Flyout drawer (slides in from the left) ============ -->
        <Grid Visibility="{Binding DrawerOpen, Converter={StaticResource BoolToVis}}">
            <!-- Scrim: click outside the drawer to close -->
            <Rectangle Fill="#99000000" MouseLeftButtonDown="OnCloseDrawer"/>

            <!-- Drawer panel -->
            <Border HorizontalAlignment="Left" Width="330" Padding="18"
                    Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="0,0,1,0">
                <Border.RenderTransform>
                    <TranslateTransform X="-340"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DrawerOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                             To="-340" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="DEVICES" Style="{StaticResource Section}" VerticalAlignment="Center"/>
                        <Button Click="OnCloseDrawer" Style="{StaticResource IconButton}"
                                Width="32" Height="32" HorizontalAlignment="Right"
                                ToolTip="Close">
                            <Path Data="M0,0 L1,1 M1,0 L0,1" Stretch="Uniform" Width="12" Height="12"
                                  Stroke="{StaticResource Fg}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Margin="2,12,2,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}" FontSize="11"
                               Text="Devices on your Wi-Fi appear here. Click Pair the first time, then they connect automatically."/>

                    <ListBox x:Name="DeviceList" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             SelectionChanged="OnDeviceSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,3"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="row" Background="#0AFFFFFF" CornerRadius="9" Padding="12,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource CardHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource CardHover}"/>
                                                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                                                    <Setter TargetName="row" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                             Fill="{Binding StatusBrush}"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Fg}"
                                                   FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="30"
                                            Content="{Binding ActionText}" Click="OnDeviceAction"
                                            Visibility="{Binding Connected, Converter={StaticResource InverseBoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
