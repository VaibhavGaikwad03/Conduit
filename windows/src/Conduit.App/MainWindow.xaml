<Window x:Class="Conduit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conduit" Height="680" Width="1020" MinWidth="820" MinHeight="580"
        Icon="pack://application:,,,/Assets/conduit.ico"
        Background="{StaticResource WindowGrad}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ SIDEBAR ============================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,24,22,22">
                    <Image Source="pack://application:,,,/Assets/conduit.ico" Width="34" Height="34"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Conduit" Style="{StaticResource H1}"/>
                        <TextBlock Foreground="{StaticResource Faint}" FontSize="11">
                            <Run Text="This PC ·"/><Run Text="{Binding SelfName}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Connection status (bottom of sidebar) -->
                <Border DockPanel.Dock="Bottom" Margin="16,10,16,16" CornerRadius="10"
                        Background="{StaticResource Card}" BorderBrush="{StaticResource StrokeSoft}"
                        BorderThickness="1" Padding="14,11">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusPillBrush}"
                                 VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AnyConnected}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="Pulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="1" To="1.9" Duration="0:0:1.1"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="1" To="1.9" Duration="0:0:1.1"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.55" Duration="0:0:1.1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="Pulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionSummary}" Margin="11,0,0,0"
                                   Foreground="{StaticResource Muted}" FontSize="11.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Device list -->
                <TextBlock DockPanel.Dock="Top" Text="DEVICES" Style="{StaticResource Section}"
                           Margin="24,0,22,10"/>
                <ListBox x:Name="DeviceList" Background="Transparent" BorderThickness="0"
                         Margin="12,0,12,0"
                         ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         SelectionChanged="OnDeviceSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="row" Background="Transparent" CornerRadius="10" Padding="12,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle x:Name="accent" Grid.Column="0" Width="3" RadiusX="2" RadiusY="2"
                                                           Fill="{StaticResource Cyan}" Opacity="0"
                                                           HorizontalAlignment="Left" Margin="-6,2,0,2"/>
                                                <ContentPresenter Grid.Column="1"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="#0AFFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{StaticResource CardHover}"/>
                                                <Setter TargetName="accent" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{Binding StatusBrush}"/>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Fg}"
                                               FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Faint}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="30" FontSize="12"
                                        Content="{Binding ActionText}" Click="OnDeviceAction"
                                        Visibility="{Binding Connected, Converter={StaticResource InverseBoolToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================ CONTENT ============================ -->
        <Grid Grid.Column="1" Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <!-- No device selected -->
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="Welcome to Conduit" Style="{StaticResource H1}" FontSize="24"/>
                    <TextBlock Text="Choose a device from the sidebar to send files, sync clipboard, control media and more."
                               Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- A device is selected -->
                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center"
                             Fill="{Binding Selected.StatusBrush}"/>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H1}" FontSize="24"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Selected.Status}" Foreground="{StaticResource Muted}" FontSize="12.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                DataContext="{Binding Selected}">
                        <Button Style="{StaticResource PrimaryButton}" Height="36"
                                Content="{Binding ActionText}" Click="OnDeviceAction"
                                Visibility="{Binding Connected, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button Style="{StaticResource GhostButton}" Height="36"
                                Content="Disconnect" Click="OnDisconnect"
                                Visibility="{Binding Connected, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource GhostButton}" Height="36" Margin="8,0,0,0"
                                Content="Forget" Click="OnForget"
                                Visibility="{Binding Paired, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Body -->
            <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel MaxWidth="1040" HorizontalAlignment="Center"
                            Width="{Binding ViewportWidth, ElementName=BodyScroll}">

                    <!-- File transfers (pinned while active) -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                            Visibility="{Binding HasTransfers, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="File transfers" Style="{StaticResource CardTitle}"/>
                            <ItemsControl ItemsSource="{Binding Transfers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Fg}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Status}" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Muted}" FontSize="12"/>
                                            </Grid>
                                            <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                         Value="{Binding Percent}" Foreground="{Binding BarBrush}"
                                                         Background="{StaticResource Stroke}" BorderThickness="0"
                                                         Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Offline hint -->
                    <Border Style="{StaticResource CardBorder}"
                            Visibility="{Binding SelectedOffline, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Device offline" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Connect this device to send files, sync clipboard and control media."
                                       Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Connected but not paired -->
                    <Border Style="{StaticResource CardBorder}"
                            Visibility="{Binding SelectedConnectedUnpaired, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Not paired yet" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Connected, but not paired. Confirm the 6-digit code on both devices to unlock features — accept the pairing request on your phone (or click Pair, then approve here)."
                                       Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- =================== Feature tabs (connected + paired) =================== -->
                    <StackPanel Visibility="{Binding SelectedReady, Converter={StaticResource BoolToVis}}">

                        <!-- Tab bar -->
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource StrokeSoft}"
                                BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,18"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabOverview" Style="{StaticResource TabToggle}" GroupName="Tabs" IsChecked="True">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xE80F;"/>
                                        <TextBlock Text="Overview" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabFiles" Style="{StaticResource TabToggle}" GroupName="Tabs">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xE8B7;"/>
                                        <TextBlock Text="Files" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabScreen" Style="{StaticResource TabToggle}" GroupName="Tabs">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xE7F4;"/>
                                        <TextBlock Text="Screen" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabNotif" Style="{StaticResource TabToggle}" GroupName="Tabs">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xE7ED;"/>
                                        <TextBlock Text="Notifications" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <!-- =============== OVERVIEW =============== -->
                            <StackPanel Style="{StaticResource TabPanel}"
                                        Visibility="{Binding IsChecked, ElementName=TabOverview, Converter={StaticResource BoolToVis}}">

                                <!-- Phone status -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Phone status" Style="{StaticResource CardTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Battery" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                                <ProgressBar Width="100" Height="6" Minimum="0" Maximum="100"
                                                             Value="{Binding BatteryLevel}" Foreground="{StaticResource Cyan}"
                                                             Background="{StaticResource Stroke}" BorderThickness="0"
                                                             VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding BatteryText}" Foreground="{StaticResource Fg}"
                                                           FontWeight="SemiBold" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource StrokeSoft}" Margin="0,14"/>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Ringer" Foreground="{StaticResource Muted}" FontSize="13"/>
                                            <TextBlock Text="{Binding RingerText}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource Fg}" FontWeight="SemiBold" FontSize="13"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Now playing" Foreground="{StaticResource Muted}" FontSize="13"/>
                                            <TextBlock Text="{Binding NowPlaying}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource Fg}" FontWeight="SemiBold" FontSize="13"
                                                       MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Quick actions -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Quick actions" Style="{StaticResource CardTitle}"/>
                                        <UniformGrid Columns="2">
                                            <Button Style="{StaticResource GhostButton}" Margin="0,0,6,10" Click="OnSendClipboard">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;"/>
                                                    <TextBlock Text="Send clipboard" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Margin="6,0,0,10" Click="OnSendFile">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE724;"/>
                                                    <TextBlock Text="Send file…" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="OnLockPhone">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;"/>
                                                    <TextBlock Text="Lock phone" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="RingButton" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnRingPhone">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="RingIcon" Style="{StaticResource Icon}" Text="&#xE7ED;"/>
                                                    <TextBlock x:Name="RingLabel" Text="Ring phone" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Media -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Media remote" Style="{StaticResource CardTitle}"/>
                                        <UniformGrid Columns="3">
                                            <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="OnMediaPrev">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE892;"/>
                                                    <TextBlock Text="Prev" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource PrimaryButton}" Margin="6,0,6,0" Click="OnMediaPlayPause">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Foreground="White" Text="&#xE768;"/>
                                                    <TextBlock Text="Play / Pause" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnMediaNext">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE893;"/>
                                                    <TextBlock Text="Next" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Open a link -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Open a link on the phone" Style="{StaticResource CardTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="LinkBox" Grid.Column="0" Height="40" VerticalContentAlignment="Center"
                                                     Padding="12,0" KeyDown="OnLinkKeyDown" CaretBrush="{StaticResource Fg}"
                                                     Background="#0AFFFFFF" Foreground="{StaticResource Fg}"
                                                     BorderBrush="{StaticResource Stroke}" BorderThickness="1"/>
                                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="40"
                                                    Margin="10,0,0,0" Click="OnOpenLink">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Foreground="White" Text="&#xE774;"/>
                                                    <TextBlock Text="Open" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="Opens the URL in your phone's browser."
                                                   Foreground="{StaticResource Faint}" FontSize="12" Margin="2,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- =============== FILES =============== -->
                            <StackPanel Style="{StaticResource TabPanel}"
                                        Visibility="{Binding IsChecked, ElementName=TabFiles, Converter={StaticResource BoolToVis}}">

                                <!-- Search -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Search phone files" Style="{StaticResource CardTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SearchBox" Grid.Column="0" Height="40" VerticalContentAlignment="Center"
                                                     Padding="12,0" KeyDown="OnSearchKeyDown" CaretBrush="{StaticResource Fg}"
                                                     Background="#0AFFFFFF" Foreground="{StaticResource Fg}"
                                                     BorderBrush="{StaticResource Stroke}" BorderThickness="1"/>
                                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="40"
                                                    Margin="10,0,0,0" Click="OnSearchFiles">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Foreground="White" Text="&#xE721;"/>
                                                    <TextBlock Text="Search" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SearchStatus}" Foreground="{StaticResource Muted}"
                                                       FontSize="12" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="30" FontSize="12"
                                                    Content="Close" Click="OnClearSearch"
                                                    Visibility="{Binding SearchActive, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0AFFFFFF" CornerRadius="9" Padding="12,10" Margin="0,0,0,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Fg}"
                                                                           FontWeight="SemiBold" FontSize="13"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="460"
                                                                           HorizontalAlignment="Left"/>
                                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Faint}" FontSize="11"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="32" Click="OnDownloadResult">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE896;"/>
                                                                    <TextBlock Text="Download" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Browse -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Browse phone files" Style="{StaticResource CardTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding BrowsePath}" Foreground="{StaticResource Fg}"
                                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding BrowseActive, Converter={StaticResource BoolToVis}}"/>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="32" FontSize="12"
                                                    Margin="8,0,0,0" Click="OnBrowseUp"
                                                    Visibility="{Binding CanGoUp, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE70E;"/>
                                                    <TextBlock Text="Up" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="32" FontSize="12"
                                                    Margin="8,0,0,0" Content="Close" Click="OnCloseBrowse"
                                                    Visibility="{Binding BrowseActive, Converter={StaticResource BoolToVis}}"/>
                                            <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Height="32" FontSize="12"
                                                    Margin="8,0,0,0" Click="OnBrowseFiles">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Foreground="White" Text="&#xE838;"/>
                                                    <TextBlock Text="Browse" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding BrowseStatus}" Foreground="{StaticResource Muted}"
                                                   FontSize="12" Margin="2,10,0,0"
                                                   Visibility="{Binding BrowseActive, Converter={StaticResource BoolToVis}}"/>
                                        <ItemsControl ItemsSource="{Binding BrowseEntries}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0AFFFFFF" CornerRadius="9" Padding="12,10" Margin="0,0,0,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                                                       FontSize="16" Foreground="{StaticResource Cyan}"
                                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Fg}"
                                                                           FontWeight="SemiBold" FontSize="13"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                                           HorizontalAlignment="Left"/>
                                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Faint}" FontSize="11"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="32" FontSize="12"
                                                                    Click="OnBrowseEntry"
                                                                    Visibility="{Binding IsDir, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Open" VerticalAlignment="Center"/>
                                                                    <TextBlock Style="{StaticResource Icon}" FontSize="13" Margin="7,0,0,0" Text="&#xE76C;"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="32" FontSize="12"
                                                                    Click="OnBrowseEntry"
                                                                    Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE896;"/>
                                                                    <TextBlock Text="Download" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- =============== SCREEN =============== -->
                            <StackPanel Style="{StaticResource TabPanel}"
                                        Visibility="{Binding IsChecked, ElementName=TabScreen, Converter={StaticResource BoolToVis}}">

                                <!-- Webcam -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Phone as webcam" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Use the phone's camera as a webcam ('Conduit Camera') in any app."
                                                   Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                        <Button x:Name="WebcamButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnToggleWebcam">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Foreground="White" Text="&#xE714;"/>
                                                <TextBlock x:Name="WebcamLabel" Text="Use phone as webcam" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SwitchCameraButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Click="OnSwitchCamera" Margin="0,10,0,0" IsEnabled="False" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/>
                                                <TextBlock x:Name="SwitchCameraLabel" Text="Switch to back camera" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Screen mirror -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Screen mirror" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Show the phone's screen in a window on this PC. You'll approve capture on the phone."
                                                   Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                        <Button x:Name="ScreenButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnToggleScreen">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Foreground="White" Text="&#xE7F4;"/>
                                                <TextBlock x:Name="ScreenLabel" Text="Mirror phone screen" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- =============== NOTIFICATIONS =============== -->
                            <StackPanel Style="{StaticResource TabPanel}"
                                        Visibility="{Binding IsChecked, ElementName=TabNotif, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Recent from phone" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                                            <Button Content="Clear" Click="OnClearNotifications" Style="{StaticResource GhostButton}"
                                                    Height="30" Padding="14,0" FontSize="12" HorizontalAlignment="Right"
                                                    ToolTip="Clear this list on the PC (your phone's notifications stay)"
                                                    Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <TextBlock Text="No notifications yet. Enable Notification access for Conduit on your phone."
                                                   Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                                   Visibility="{Binding HasNotifications, Converter={StaticResource InverseBoolToVis}}"/>
                                        <ItemsControl ItemsSource="{Binding Notifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0AFFFFFF" CornerRadius="9" Padding="13,10" Margin="0,0,0,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Fg}" FontSize="13">
                                                                    <Run Text="{Binding AppName}"/><Run Text="  ·  "/><Run Text="{Binding Title}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Text}" Foreground="{StaticResource Muted}"
                                                                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Faint}"
                                                                           FontSize="10" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Click="OnDismissNotification"
                                                                    Style="{StaticResource IconButton}"
                                                                    Width="28" Height="28" VerticalAlignment="Top" Margin="8,0,0,0"
                                                                    ToolTip="Remove this one from the PC list">
                                                                <Path Data="M0,0 L1,1 M1,0 L0,1" Stretch="Uniform"
                                                                      Width="11" Height="11" Stroke="#FF6B6B" StrokeThickness="1.7"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================ Toast / snackbar ============================ -->
        <Border x:Name="Toast" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,28" CornerRadius="10" Padding="18,12"
                Background="#F21D3A54" BorderBrush="{StaticResource Cyan}" BorderThickness="1"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}"
                RenderTransformOrigin="0.5,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.5" Color="#00060C"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="0"/>
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="24" To="0" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ToastText}" Foreground="{StaticResource Fg}"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="460"/>
        </Border>
    </Grid>
</Window>
