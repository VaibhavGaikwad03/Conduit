<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ConduitAgent</AssemblyName>
    <RootNamespace>Conduit.Agent</RootNamespace>
    <!-- The LocalSystem agent brokers desktop capture/input; it must be 64-bit like the app + native DLL. -->
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conduit.Core\Conduit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>

  <!-- Build the helper first; it is co-located with the agent at install time (not copied here,
       since a framework-dependent exe drags several files). ReferenceOutputAssembly=false: we launch
       it as a process, we don't link against it. -->
  <ItemGroup>
    <ProjectReference Include="..\Conduit.Helper\Conduit.Helper.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
