<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe so no console window flashes when the agent launches it onto a desktop. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ConduitHelper</AssemblyName>
    <RootNamespace>Conduit.Helper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conduit.Core\Conduit.Core.csproj" />
  </ItemGroup>

  <!-- The helper captures the desktop through the native DXGI/H.264 module, so it needs the DLL
       next to it (same bundled copy the app uses). -->
  <ItemGroup>
    <None Include="..\..\native\ConduitCamera\build\Release\ConduitCamera.dll"
          Condition="Exists('..\..\native\ConduitCamera\build\Release\ConduitCamera.dll')"
          Link="ConduitCamera.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
